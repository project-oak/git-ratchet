load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "gitlog",
    srcs = [
        "entry.go",
        "gitlog.go",
    ],
    importpath = "github.com/project-oak/git-ratchet/internal/gitlog",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/gitutil",
        "//internal/tlog",
        "@com_github_transparency_dev_tessera//api",
        "@com_github_transparency_dev_tessera//api/layout",
    ],
)

go_test(
    name = "gitlog_test",
    srcs = [
        "entry_test.go",
        "gitlog_test.go",
    ],
    embed = [":gitlog"],
    deps = [
        "//internal/tlog",
        "@com_github_transparency_dev_tessera//api",
    ],
)
