module(
    name = "git-ratchet",
    version = "0.0.1",
)

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.51.0")
bazel_dep(name = "rules_tofu", version = "0.4.0")

# Build with the Go release that go.mod names, not rules_go's default SDK, so
# that a dependency whose go.mod needs a newer Go than that default can still
# be fetched.
#
# Dependabot's Bazel updater fetches only the files that MODULE.bazel names in
# attributes it knows, such as lock_file and from_file, and go_mod is not one
# of them. Without go.mod and go.sum it cannot regenerate MODULE.bazel.lock.
# It matches those attributes in comments too, so the next two lines make it
# fetch both files. Do not remove them.
#   from_file = "//:go.mod"
#   from_file = "//:go.sum"
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_google_go_github_v68", "com_github_google_subcommands", "com_github_transparency_dev_formats", "com_github_transparency_dev_merkle", "com_github_transparency_dev_tessera", "com_github_transparency_dev_witness", "com_google_cloud_go_kms", "io_filippo_mldsa", "org_golang_google_protobuf", "org_golang_x_mod")

tf_providers = use_extension("@rules_tofu//tf/providers:extensions.bzl", "tf_providers")
tf_providers.from_lock(lock_file = "//deploy/origin:.terraform.lock.hcl")
use_repo(tf_providers, "tf_providers")
