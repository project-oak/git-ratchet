module(
    name = "git-ratchet",
    version = "0.0.1",
)

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.51.0")
bazel_dep(name = "rules_tofu", version = "0.3.1")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_google_go_github_v68", "com_github_google_subcommands", "com_github_transparency_dev_formats", "com_github_transparency_dev_merkle", "com_github_transparency_dev_tessera", "com_github_transparency_dev_witness", "com_google_cloud_go_kms", "io_filippo_mldsa", "org_golang_google_protobuf", "org_golang_x_mod")

tf_providers = use_extension("@rules_tofu//tf/providers:extensions.bzl", "tf_providers")
tf_providers.from_lock(lock = "//deploy/origin:.terraform.lock.hcl")
use_repo(tf_providers, "tf_providers")
